package com.cp.workskillai.service;

import com.cp.workskillai.dto.SkillGapAnalysisRequest;
import com.cp.workskillai.dto.SkillGapAnalysisResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.stereotype.Service;
import java.util.Map;

@Service
@RequiredArgsConstructor
@Slf4j
public class SkillGapAnalysisService {
    
    private final UserDataService userDataService;
    private final PythonServiceClient pythonServiceClient;
    
    public SkillGapAnalysisResponse analyzeSkillGap(SkillGapAnalysisRequest request) {
        try {
            String userId = request.getUserId();
            String jobRole = request.getJobRole();
            
            log.info("Starting skill gap analysis for user: {}, role: {}", userId, jobRole);
            
            // Get user data from database
            Map<String, Object> userData = userDataService.getUserSkillGapData(userId);
            
            // Call Python service for analysis
            SkillGapAnalysisResponse analysisResult = pythonServiceClient.analyzeSkillGap(userData, jobRole);
            
            log.info("Skill gap analysis completed successfully. Match score: {}%", 
                    analysisResult.getMatchScore());
            
            return analysisResult;
            
        } catch (Exception e) {
            log.error("Skill gap analysis failed: {}", e.getMessage());
            throw new RuntimeException("Skill gap analysis failed: " + e.getMessage());
        }
    }
}