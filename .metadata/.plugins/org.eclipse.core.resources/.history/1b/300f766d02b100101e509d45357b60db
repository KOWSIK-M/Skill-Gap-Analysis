package com.cp.workskillai.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.util.*;

@Slf4j
@Service
@RequiredArgsConstructor
public class HuggingFaceExamService {
    
    private final RestTemplate restTemplate;
    
    @Value("${huggingface.api.key:}")
    private String huggingFaceApiKey;
    
    @Value("${huggingface.api.url:https://api-inference.huggingface.co/models}")
    private String huggingFaceApiUrl;
    
    public Map<String, Object> generateExamQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            // Try Hugging Face API first
            Map<String, Object> huggingFaceExam = generateWithHuggingFace(skill, category, difficulty, numberOfQuestions);
            if (huggingFaceExam != null && !huggingFaceExam.containsKey("error")) {
                log.info("Successfully generated exam using Hugging Face for skill: {}", skill);
                return huggingFaceExam;
            }
            
            // Fallback to enhanced rule-based questions
            log.warn("Hugging Face API failed, using rule-based questions for skill: {}", skill);
            return generateEnhancedRuleBasedQuestions(skill, category, difficulty, numberOfQuestions);
            
        } catch (Exception e) {
            log.error("Error generating exam with Hugging Face for skill: {}", skill, e);
            return generateEnhancedRuleBasedQuestions(skill, category, difficulty, numberOfQuestions);
        }
    }
    
    private Map<String, Object> generateWithHuggingFace(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            if (huggingFaceApiKey == null || huggingFaceApiKey.isEmpty()) {
                log.warn("Hugging Face API key not configured");
                return null;
            }
            
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            headers.set("Authorization", "Bearer " + huggingFaceApiKey);
            
            String prompt = createHuggingFacePrompt(skill, category, difficulty, numberOfQuestions);
            
            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("inputs", prompt);
            requestBody.put("parameters", Map.of(
                "max_new_tokens", 1024,
                "temperature", 0.7,
                "do_sample", true,
                "return_full_text", false
            ));
            
            HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
            
            // Using a good general-purpose model
            String model = "HuggingFaceH4/zephyr-7b-beta";
            
            ResponseEntity<Map> response = restTemplate.exchange(
                huggingFaceApiUrl + "/" + model,
                HttpMethod.POST,
                request,
                Map.class
            );
            
            if (response.getStatusCode() == HttpStatus.OK) {
                return parseHuggingFaceResponse(response.getBody(), skill, numberOfQuestions);
            } else {
                log.warn("Hugging Face API returned status: {}", response.getStatusCode());
                return null;
            }
            
        } catch (Exception e) {
            log.warn("Hugging Face API call failed: {}", e.getMessage());
            return null;
        }
    }
    
    private String createHuggingFacePrompt(String skill, String category, String difficulty, int numberOfQuestions) {
        return String.format(
            "Create exactly %d multiple choice questions about %s programming language. " +
            "Difficulty: %s. Category: %s.\n\n" +
            "FORMAT REQUIREMENTS:\n" +
            "- Each question must start with 'Q:' followed by the question text\n" +
            "- Then exactly 4 options labeled A), B), C), D)\n" +
            "- End with 'Correct:' followed by the correct letter (A, B, C, or D)\n" +
            "- Separate questions with a blank line\n\n" +
            "EXAMPLE:\n" +
            "Q: What is the main purpose of this technology?\n" +
            "A) Frontend development\n" +
            "B) Backend development\n" +
            "C) Database management\n" +
            "D) All of the above\n" +
            "Correct: D\n\n" +
            "Now generate %d questions about %s:",
            numberOfQuestions, skill, difficulty, category, numberOfQuestions, skill
        );
    }
    
    private Map<String, Object> parseHuggingFaceResponse(Map<String, Object> response, String skill, int numberOfQuestions) {
        try {
            List<Map<String, Object>> questions = new ArrayList<>();
            
            if (response.containsKey("generated_text")) {
                String generatedText = (String) response.get("generated_text");
                log.debug("Raw Hugging Face response: {}", generatedText);
                questions = parseGeneratedQuestions(generatedText, skill);
            }
            
            // If we got valid questions from Hugging Face, return them
            if (!questions.isEmpty() && questions.size() >= Math.min(3, numberOfQuestions)) {
                Map<String, Object> result = new HashMap<>();
                result.put("questions", questions);
                result.put("totalQuestions", questions.size());
                result.put("skill", skill);
                result.put("source", "huggingface");
                result.put("generatedAt", new Date());
                return result;
            }
            
            return null;
            
        } catch (Exception e) {
            log.error("Error parsing Hugging Face response", e);
            return null;
        }
    }
    
    private List<Map<String, Object>> parseGeneratedQuestions(String text, String skill) {
        List<Map<String, Object>> questions = new ArrayList<>();
        String[] lines = text.split("\n");
        
        Map<String, Object> currentQuestion = null;
        int questionCount = 0;
        
        for (String line : lines) {
            line = line.trim();
            
            // Look for "Q:" instead of "Q%d:"
            if (line.startsWith("Q:") || line.startsWith("Q ")) {
                if (currentQuestion != null && currentQuestion.containsKey("question")) {
                    questions.add(currentQuestion);
                }
                currentQuestion = new HashMap<>();
                currentQuestion.put("id", ++questionCount);
                
                // Extract question text after "Q:" or "Q "
                String questionText = line.substring(line.indexOf(":") + 1).trim();
                if (questionText.isEmpty()) {
                    // If it's "Q " format, get everything after "Q "
                    questionText = line.substring(line.indexOf("Q") + 1).trim();
                    if (questionText.startsWith(":")) {
                        questionText = questionText.substring(1).trim();
                    }
                }
                currentQuestion.put("question", questionText);
                currentQuestion.put("options", new ArrayList<String>());
            } 
            else if (line.matches("^[A-D]\\) .*")) {
                if (currentQuestion != null) {
                    List<String> options = (List<String>) currentQuestion.get("options");
                    options.add(line.substring(3).trim());
                }
            } 
            else if (line.startsWith("Correct:")) {
                if (currentQuestion != null) {
                    String correctAnswer = line.substring(8).trim().toUpperCase();
                    int correctIndex = mapAnswerToIndex(correctAnswer);
                    currentQuestion.put("correct", correctIndex);
                }
            }
        }
        
        // Add the last question
        if (currentQuestion != null && currentQuestion.containsKey("question") && 
            currentQuestion.containsKey("correct")) {
            questions.add(currentQuestion);
        }
        
        return questions;
    }
    
    private int mapAnswerToIndex(String answer) {
        return switch (answer) {
            case "A" -> 0;
            case "B" -> 1;
            case "C" -> 2;
            case "D" -> 3;
            default -> 0;
        };
    }
    
    // Enhanced rule-based questions as fallback
    private Map<String, Object> generateEnhancedRuleBasedQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> questions = new ArrayList<>();
        Random random = new Random();
        
        Map<String, List<QuestionTemplate>> questionTemplates = getEnhancedQuestionTemplates();
        List<QuestionTemplate> templates = questionTemplates.getOrDefault(category.toLowerCase(), 
                                           questionTemplates.get("programming"));
        
        for (int i = 0; i < numberOfQuestions && i < templates.size(); i++) {
            QuestionTemplate template = templates.get(i % templates.size());
            Map<String, Object> question = new HashMap<>();
            question.put("id", i + 1);
            question.put("question", String.format(template.getQuestion(), skill));
            question.put("options", template.getOptions());
            question.put("correct", template.getCorrectIndex());
            questions.add(question);
        }
        
        result.put("questions", questions);
        result.put("totalQuestions", questions.size());
        result.put("skill", skill);
        result.put("category", category);
        result.put("difficulty", difficulty);
        result.put("source", "rule-based");
        result.put("generatedAt", new Date());
        
        return result;
    }
    
    private Map<String, List<QuestionTemplate>> getEnhancedQuestionTemplates() {
        Map<String, List<QuestionTemplate>> templates = new HashMap<>();
        
        // Programming questions
        templates.put("programming", Arrays.asList(
            new QuestionTemplate("What is the primary paradigm of %s?", 
                Arrays.asList("Object-oriented", "Functional", "Procedural", "Multi-paradigm"), 3),
            new QuestionTemplate("Which company primarily maintains %s?", 
                Arrays.asList("Microsoft", "Google", "Open Source Community", "Facebook"), 2),
            new QuestionTemplate("What is %s commonly used for?", 
                Arrays.asList("Web development", "Mobile apps", "Data science", "All of the above"), 3),
            new QuestionTemplate("Which tool is essential for %s development?", 
                Arrays.asList("Package manager", "IDE", "Version control", "All of the above"), 3)
        ));
        
        // Frontend questions
        templates.put("frontend", Arrays.asList(
            new QuestionTemplate("What problem does %s solve in web development?", 
                Arrays.asList("State management", "UI rendering", "Performance optimization", "All of the above"), 3),
            new QuestionTemplate("How does %s handle component updates?", 
                Arrays.asList("Virtual DOM", "Direct DOM manipulation", "Shadow DOM", "Incremental DOM"), 0),
            new QuestionTemplate("Which build tool is commonly used with %s?", 
                Arrays.asList("Webpack", "Vite", "Parcel", "All of the above"), 3)
        ));
        
        // Backend questions
        templates.put("backend", Arrays.asList(
            new QuestionTemplate("How does %s handle concurrent requests?", 
                Arrays.asList("Multi-threading", "Event loop", "Worker processes", "All of the above"), 1),
            new QuestionTemplate("Which database works best with %s?", 
                Arrays.asList("MySQL", "MongoDB", "PostgreSQL", "Depends on use case"), 3),
            new QuestionTemplate("What is the main advantage of using %s?", 
                Arrays.asList("Scalability", "Development speed", "Community support", "All of the above"), 3)
        ));
        
        return templates;
    }
    
    // Helper class for question templates
    private static class QuestionTemplate {
        private final String question;
        private final List<String> options;
        private final int correctIndex;
        
        public QuestionTemplate(String question, List<String> options, int correctIndex) {
            this.question = question;
            this.options = options;
            this.correctIndex = correctIndex;
        }
        
        public String getQuestion() { return question; }
        public List<String> getOptions() { return options; }
        public int getCorrectIndex() { return correctIndex; }
    }
    
    public Map<String, Object> evaluateAnswerWithAI(String question, String userAnswer, String context) {
        // Implementation for answer evaluation
        return Map.of("score", 75, "feedback", "Good understanding shown", "confidence", 0.8);
    }
}