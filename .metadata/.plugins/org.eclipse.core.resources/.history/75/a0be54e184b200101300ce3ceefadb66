// SkillGapAnalysisResponse.java
package com.cp.workskillai.dto;

import lombok.Data;
import com.fasterxml.jackson.annotation.JsonProperty;
import java.util.List;
import java.util.Map;

@Data
public class SkillGapAnalysisResponse {
    private String jobRole;
    
    @JsonProperty("match_score")
    private Double matchScore; // This will map both "match_score" and "matchScore"
    
    @JsonProperty("required_skills")
    private List<SkillAnalysis> requiredSkills;
    
    @JsonProperty("current_skills") 
    private List<UserSkillAnalysis> currentSkills;
    
    @JsonProperty("missing_skills")
    private List<SkillAnalysis> missingSkills;
    
    @JsonProperty("partial_match_skills")
    private List<SkillAnalysis> partialMatchSkills;
    
    @JsonProperty("gap_analysis")
    private Map<String, Object> gapAnalysis;
    
    private List<String> recommendations;
    
    @JsonProperty("time_to_close_gap")
    private String timeToCloseGap;
    
    @JsonProperty("salary_impact")
    private String salaryImpact;
    
    private String userId;
    
    // Add getter that handles both field names
    public Double getMatchScore() {
        return matchScore;
    }
    
    // Add setter that handles both field names  
    public void setMatchScore(Double matchScore) {
        this.matchScore = matchScore;
    }
    
    // Handle the case where Python sends "match_score"
    @JsonProperty("match_score")
    public void setMatchScoreFromPython(Double matchScore) {
        this.matchScore = matchScore;
    }
}