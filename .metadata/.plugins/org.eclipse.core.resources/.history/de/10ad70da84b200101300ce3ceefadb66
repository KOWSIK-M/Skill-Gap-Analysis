// PythonServiceClient.java
package com.cp.workskillai.service;

import com.cp.workskillai.dto.SkillGapAnalysisResponse;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;
import java.util.Map;

//PythonServiceClient.java
@Service
@RequiredArgsConstructor
@Slf4j
public class PythonServiceClient {
 
 private final RestTemplate restTemplate;
 private final ObjectMapper objectMapper;
 private final String PYTHON_SERVICE_URL = "http://localhost:8000";
 
 public SkillGapAnalysisResponse analyzeSkillGap(Map<String, Object> userData, String jobRole) {
     try {
         // Prepare request for Python service
         Map<String, Object> requestBody = Map.of(
             "user_id", userData.get("userId"),
             "job_role", jobRole,
             "profile_data", userData.get("profile"),
             "skills_data", userData.get("skills")
         );
         
         HttpHeaders headers = new HttpHeaders();
         headers.setContentType(MediaType.APPLICATION_JSON);
         
         HttpEntity<Map<String, Object>> requestEntity = new HttpEntity<>(requestBody, headers);
         
         log.info("Calling Python service for skill gap analysis...");
         
         // First get the response as String to handle field mapping
         ResponseEntity<String> stringResponse = restTemplate.exchange(
             PYTHON_SERVICE_URL + "/internal-analyze",
             HttpMethod.POST,
             requestEntity,
             String.class
         );
         
         if (stringResponse.getStatusCode() == HttpStatus.OK && stringResponse.getBody() != null) {
             // Convert snake_case to camelCase
             String camelCaseBody = convertSnakeToCamel(stringResponse.getBody());
             
             // Parse to DTO
             SkillGapAnalysisResponse response = objectMapper.readValue(
                 camelCaseBody, 
                 SkillGapAnalysisResponse.class
             );
             
             log.info("Successfully received analysis from Python service. Match score: {}%", 
                      response.getMatchScore());
             return response;
         } else {
             throw new RuntimeException("Python service returned error: " + stringResponse.getStatusCode());
         }
         
     } catch (Exception e) {
         log.error("Error calling Python service: {}", e.getMessage());
         throw new RuntimeException("Failed to analyze skill gap: " + e.getMessage());
     }
 }
 
 private String convertSnakeToCamel(String json) {
     // Simple conversion: match_score -> matchScore
     return json.replaceAll("_([a-z])", "$1")
               .replace("match_score", "matchScore")
               .replace("required_skills", "requiredSkills")
               .replace("current_skills", "currentSkills")
               .replace("missing_skills", "missingSkills")
               .replace("partial_match_skills", "partialMatchSkills")
               .replace("gap_analysis", "gapAnalysis")
               .replace("time_to_close_gap", "timeToCloseGap")
               .replace("salary_impact", "salaryImpact");
 }
}