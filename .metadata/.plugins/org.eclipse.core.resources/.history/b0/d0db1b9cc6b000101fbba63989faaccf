spring.application.name=workskillai
server.port=2090

# JWT Configuration
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION}

# Gemini AI
gemini.api.key=${GEMINI_API_KEY}

# Hugging Face API Configuration
huggingface.api.key=your_huggingface_api_key_here
huggingface.api.url=https://api-inference.huggingface.co/models

# You can get a free API key from https://huggingface.co/settings/tokens

# File upload
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=5MB

# MongoDB Configuration

spring.data.mongodb.host=localhost
spring.data.mongodb.port=27017
spring.data.mongodb.database=workskillai
spring.data.mongodb.authentication-database=admin

# Logging

logging.level.org.springframework.data.mongodb.core.MongoTemplate=DEBUG
logging.level.org.springframework.web=INFO