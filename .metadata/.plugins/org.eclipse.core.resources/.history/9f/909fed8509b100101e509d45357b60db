@GetMapping("/test-inference-providers")
public ResponseEntity<Map<String, Object>> testInferenceProviders() {
    try {
        HttpHeaders headers = new HttpHeaders();
        headers.setContentType(MediaType.APPLICATION_JSON);
        headers.set("Authorization", "Bearer " + huggingFaceApiKey);
        
        // Test OpenAI-compatible endpoint
        Map<String, Object> requestBody = new HashMap<>();
        requestBody.put("model", "microsoft/DialoGPT-small");
        requestBody.put("messages", List.of(
            Map.of("role", "user", "content", "Hello, this is a test message.")
        ));
        requestBody.put("max_tokens", 50);
        
        HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
        
        ResponseEntity<Map> response = restTemplate.exchange(
            "https://router.huggingface.co/hf-inference/v1/chat/completions",
            HttpMethod.POST,
            request,
            Map.class
        );
        
        return ResponseEntity.ok(Map.of(
            "status", response.getStatusCode().toString(),
            "success", response.getStatusCode() == HttpStatus.OK,
            "response_sample", response.getBody() != null ? "Received response" : "No response body"
        ));
        
    } catch (Exception e) {
        return ResponseEntity.status(HttpStatus.INTERNAL_SERVER_ERROR)
            .body(Map.of("error", e.getMessage()));
    }
}