// SkillGapAnalysis.java (Entity)
package com.cp.workskillai.models;

import lombok.Data;
import jakarta.persistence.*;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Map;

@Entity
@Table(name = "skill_gap_analysis")
@Data
public class SkillGapAnalysis {
    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;
    
    @Column(nullable = false)
    private String userId;
    
    @Column(nullable = false)
    private String jobRole;
    
    private Double matchScore;
    
    @Column(columnDefinition = "TEXT")
    private String requiredSkills; // JSON string
    
    @Column(columnDefinition = "TEXT")
    private String currentSkills; // JSON string
    
    @Column(columnDefinition = "TEXT")
    private String missingSkills; // JSON string
    
    @Column(columnDefinition = "TEXT")
    private String partialMatchSkills; // JSON string
    
    @Column(columnDefinition = "TEXT")
    private String gapAnalysis; // JSON string
    
    @Column(columnDefinition = "TEXT")
    private String recommendations; // JSON string
    
    private String timeToCloseGap;
    private String salaryImpact;
    
    private Boolean isCurrentRole = false;
    
    private LocalDateTime analyzedAt;
    
    @PrePersist
    protected void onCreate() {
        analyzedAt = LocalDateTime.now();
    }
}