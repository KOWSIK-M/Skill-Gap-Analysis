package com.cp.workskillai.service;

import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.util.*;

@Slf4j
@Service
@RequiredArgsConstructor
public class HuggingFaceExamService {
    
    private final RestTemplate restTemplate;
    
    @Value("${huggingface.api.key:}")
    private String huggingFaceApiKey;
    
    // Updated endpoint for Inference Providers
    @Value("${huggingface.api.url:https://router.huggingface.co}")
    private String huggingFaceApiUrl;
    
    public Map<String, Object> generateExamQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            // Try new Hugging Face Inference Providers API first
            Map<String, Object> huggingFaceExam = generateWithInferenceProviders(skill, category, difficulty, numberOfQuestions);
            if (huggingFaceExam != null && !huggingFaceExam.containsKey("error")) {
                log.info("Successfully generated exam using Hugging Face Inference Providers for skill: {}", skill);
                return huggingFaceExam;
            }
            
            // Fallback to enhanced rule-based questions
            log.warn("Hugging Face API failed, using rule-based questions for skill: {}", skill);
            return generateEnhancedRuleBasedQuestions(skill, category, difficulty, numberOfQuestions);
            
        } catch (Exception e) {
            log.error("Error generating exam with Hugging Face for skill: {}", skill, e);
            return generateEnhancedRuleBasedQuestions(skill, category, difficulty, numberOfQuestions);
        }
    }
    
    /**
     * New method for Hugging Face Inference Providers API
     * Based on: https://huggingface.co/docs/inference-providers/index
     */
    private Map<String, Object> generateWithInferenceProviders(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            if (huggingFaceApiKey == null || huggingFaceApiKey.isEmpty()) {
                log.warn("Hugging Face API key not configured");
                return null;
            }
            
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            headers.set("Authorization", "Bearer " + huggingFaceApiKey);
            
            String prompt = createHuggingFacePrompt(skill, category, difficulty, numberOfQuestions);
            
            // Correct request format for Inference Providers
            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("model", "microsoft/DialoGPT-small"); // Specify model in request body
            requestBody.put("inputs", prompt);
            requestBody.put("parameters", Map.of(
                "max_new_tokens", 1024,
                "temperature", 0.7,
                "do_sample", true,
                "return_full_text", false
            ));
            
            HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
            
            // Try different Inference Providers endpoints
            String[] endpoints = {
                huggingFaceApiUrl + "/hf-inference/models",  // Main inference endpoint
                huggingFaceApiUrl + "/hf-inference/v1/models" // Alternative endpoint
            };
            
            for (String endpoint : endpoints) {
                try {
                    log.info("Trying Inference Providers endpoint: {}", endpoint);
                    
                    ResponseEntity<Map> response = restTemplate.exchange(
                        endpoint,
                        HttpMethod.POST,
                        request,
                        Map.class
                    );
                    
                    if (response.getStatusCode() == HttpStatus.OK) {
                        log.info("Success with Inference Providers endpoint: {}", endpoint);
                        return parseHuggingFaceResponse(response.getBody(), skill, numberOfQuestions);
                    } else {
                        log.warn("Endpoint {} returned status: {}", endpoint, response.getStatusCode());
                        // Log response body for debugging
                        if (response.getBody() != null) {
                            log.warn("Response body: {}", response.getBody());
                        }
                    }
                } catch (Exception e) {
                    log.warn("Endpoint {} failed: {}", endpoint, e.getMessage());
                    continue;
                }
            }
            
            log.warn("All Inference Providers endpoints failed");
            return null;
            
        } catch (Exception e) {
            log.warn("Hugging Face Inference Providers API call failed: {}", e.getMessage());
            return null;
        }
    }
    
    /**
     * Alternative: Use OpenAI-compatible endpoint (recommended approach)
     * This is often more reliable with the new API
     */
    private Map<String, Object> generateWithOpenAICompatible(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            if (huggingFaceApiKey == null || huggingFaceApiKey.isEmpty()) {
                return null;
            }
            
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            headers.set("Authorization", "Bearer " + huggingFaceApiKey);
            
            String prompt = createHuggingFacePrompt(skill, category, difficulty, numberOfQuestions);
            
            // OpenAI-compatible format (often works better)
            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("model", "microsoft/DialoGPT-small");
            requestBody.put("messages", List.of(
                Map.of("role", "user", "content", prompt)
            ));
            requestBody.put("max_tokens", 1024);
            requestBody.put("temperature", 0.7);
            requestBody.put("stream", false);
            
            HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
            
            // OpenAI-compatible endpoints
            String[] endpoints = {
                huggingFaceApiUrl + "/hf-inference/v1/chat/completions",
                huggingFaceApiUrl + "/v1/chat/completions",
                "https://router.huggingface.co/hf-inference/v1/chat/completions"
            };
            
            for (String endpoint : endpoints) {
                try {
                    log.info("Trying OpenAI-compatible endpoint: {}", endpoint);
                    
                    ResponseEntity<Map> response = restTemplate.exchange(
                        endpoint,
                        HttpMethod.POST,
                        request,
                        Map.class
                    );
                    
                    if (response.getStatusCode() == HttpStatus.OK) {
                        log.info("Success with OpenAI-compatible endpoint: {}", endpoint);
                        return parseOpenAIResponse(response.getBody(), skill, numberOfQuestions);
                    } else {
                        log.warn("OpenAI endpoint {} returned status: {}", endpoint, response.getStatusCode());
                    }
                } catch (Exception e) {
                    log.warn("OpenAI endpoint {} failed: {}", endpoint, e.getMessage());
                    continue;
                }
            }
            
            return null;
            
        } catch (Exception e) {
            log.warn("OpenAI-compatible API call failed: {}", e.getMessage());
            return null;
        }
    }
    
    /**
     * Parse OpenAI-compatible response format
     */
    private Map<String, Object> parseOpenAIResponse(Map<String, Object> response, String skill, int numberOfQuestions) {
        try {
            List<Map<String, Object>> questions = new ArrayList<>();
            
            if (response.containsKey("choices")) {
                List<Map<String, Object>> choices = (List<Map<String, Object>>) response.get("choices");
                if (!choices.isEmpty()) {
                    Map<String, Object> firstChoice = choices.get(0);
                    if (firstChoice.containsKey("message")) {
                        Map<String, Object> message = (Map<String, Object>) firstChoice.get("message");
                        String content = (String) message.get("content");
                        log.debug("OpenAI response content: {}", content);
                        questions = parseGeneratedQuestions(content, skill);
                    }
                }
            }
            
            if (!questions.isEmpty() && questions.size() >= Math.min(3, numberOfQuestions)) {
                Map<String, Object> result = new HashMap<>();
                result.put("questions", questions);
                result.put("totalQuestions", questions.size());
                result.put("skill", skill);
                result.put("source", "huggingface-openai");
                result.put("generatedAt", new Date());
                return result;
            }
            
            return null;
            
        } catch (Exception e) {
            log.error("Error parsing OpenAI-compatible response", e);
            return null;
        }
    }
    
    /**
     * Updated main method to try both approaches
     */
    private Map<String, Object> generateWithHuggingFace(String skill, String category, String difficulty, int numberOfQuestions) {
        // Try OpenAI-compatible first (more reliable)
        Map<String, Object> result = generateWithOpenAICompatible(skill, category, difficulty, numberOfQuestions);
        if (result != null) {
            return result;
        }
        
        // Fall back to direct Inference Providers API
        return generateWithInferenceProviders(skill, category, difficulty, numberOfQuestions);
    }
    
    // Keep all the existing helper methods (they remain the same):
    private String createHuggingFacePrompt(String skill, String category, String difficulty, int numberOfQuestions) {
        return String.format(
            "Create exactly %d multiple choice questions about %s. " +
            "Difficulty: %s. Category: %s.\n\n" +
            "FORMAT REQUIREMENTS:\n" +
            "- Each question must start with 'Q:' followed by the question text\n" +
            "- Then exactly 4 options labeled A), B), C), D)\n" +
            "- End with 'Correct:' followed by the correct letter (A, B, C, or D)\n" +
            "- Separate questions with a blank line\n\n" +
            "EXAMPLE:\n" +
            "Q: What is the main purpose of this technology?\n" +
            "A) Frontend development\n" +
            "B) Backend development\n" +
            "C) Database management\n" +
            "D) All of the above\n" +
            "Correct: D\n\n" +
            "Now generate %d questions about %s:",
            numberOfQuestions, skill, difficulty, category, numberOfQuestions, skill
        );
    }
    
    private Map<String, Object> parseHuggingFaceResponse(Map<String, Object> response, String skill, int numberOfQuestions) {
        try {
            List<Map<String, Object>> questions = new ArrayList<>();
            
            if (response.containsKey("generated_text")) {
                String generatedText = (String) response.get("generated_text");
                log.debug("Raw Hugging Face response: {}", generatedText);
                questions = parseGeneratedQuestions(generatedText, skill);
            }
            
            if (!questions.isEmpty() && questions.size() >= Math.min(3, numberOfQuestions)) {
                Map<String, Object> result = new HashMap<>();
                result.put("questions", questions);
                result.put("totalQuestions", questions.size());
                result.put("skill", skill);
                result.put("source", "huggingface");
                result.put("generatedAt", new Date());
                return result;
            }
            
            return null;
            
        } catch (Exception e) {
            log.error("Error parsing Hugging Face response", e);
            return null;
        }
    }
    
    private List<Map<String, Object>> parseGeneratedQuestions(String text, String skill) {
        List<Map<String, Object>> questions = new ArrayList<>();
        String[] lines = text.split("\n");
        
        Map<String, Object> currentQuestion = null;
        int questionCount = 0;
        
        for (String line : lines) {
            line = line.trim();
            
            if (line.startsWith("Q:") || line.startsWith("Q ")) {
                if (currentQuestion != null && currentQuestion.containsKey("question")) {
                    questions.add(currentQuestion);
                }
                currentQuestion = new HashMap<>();
                currentQuestion.put("id", ++questionCount);
                
                String questionText = line.substring(line.indexOf(":") + 1).trim();
                if (questionText.isEmpty()) {
                    questionText = line.substring(line.indexOf("Q") + 1).trim();
                    if (questionText.startsWith(":")) {
                        questionText = questionText.substring(1).trim();
                    }
                }
                currentQuestion.put("question", questionText);
                currentQuestion.put("options", new ArrayList<String>());
            } 
            else if (line.matches("^[A-D]\\) .*")) {
                if (currentQuestion != null) {
                    List<String> options = (List<String>) currentQuestion.get("options");
                    options.add(line.substring(3).trim());
                }
            } 
            else if (line.startsWith("Correct:")) {
                if (currentQuestion != null) {
                    String correctAnswer = line.substring(8).trim().toUpperCase();
                    int correctIndex = mapAnswerToIndex(correctAnswer);
                    currentQuestion.put("correct", correctIndex);
                }
            }
        }
        
        if (currentQuestion != null && currentQuestion.containsKey("question") && 
            currentQuestion.containsKey("correct")) {
            questions.add(currentQuestion);
        }
        
        return questions;
    }
    
    private int mapAnswerToIndex(String answer) {
        return switch (answer) {
            case "A" -> 0;
            case "B" -> 1;
            case "C" -> 2;
            case "D" -> 3;
            default -> 0;
        };
    }
    
    // Enhanced rule-based questions (keep this as your primary reliable solution)
    private Map<String, Object> generateEnhancedRuleBasedQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        Map<String, Object> result = new HashMap<>();
        List<Map<String, Object>> questions = getSkillSpecificQuestions(skill, category, difficulty, numberOfQuestions);
        
        result.put("questions", questions);
        result.put("totalQuestions", questions.size());
        result.put("skill", skill);
        result.put("category", category);
        result.put("difficulty", difficulty);
        result.put("source", "enhanced-rule-based");
        result.put("generatedAt", new Date());
        
        return result;
    }
    
    // ... keep all the getSkillSpecificQuestions, createQuestion, 
    // generateGenericProgrammingQuestions methods from previous implementation ...
    // (They remain exactly the same)
    
    private List<Map<String, Object>> getSkillSpecificQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        String skillLower = skill.toLowerCase();
        List<Map<String, Object>> questions = new ArrayList<>();
        
        // Data Warehousing specific questions
        if (skillLower.contains("data warehousing") || skillLower.contains("data warehouse") || skillLower.contains("etl")) {
            List<Map<String, Object>> dwQuestions = Arrays.asList(
                createQuestion(1, "What is the primary purpose of a data warehouse?", 
                    Arrays.asList("Real-time transaction processing", "Historical data analysis and reporting", "Website hosting", "Mobile app development"), 1),
                createQuestion(2, "Which schema design is most common in data warehousing?", 
                    Arrays.asList("Star Schema", "Network Schema", "Object-oriented Schema", "Hierarchical Schema"), 0),
                createQuestion(3, "What does ETL stand for in data warehousing?", 
                    Arrays.asList("Extract, Transform, Load", "Extract, Transfer, Load", "Enter, Transform, Leave", "Export, Transform, Load"), 0),
                createQuestion(4, "Which is NOT a common data warehouse component?", 
                    Arrays.asList("OLAP cubes", "Data marts", "ETL tools", "Web servers"), 3),
                createQuestion(5, "What is the main advantage of a data warehouse over operational databases?", 
                    Arrays.asList("Faster transaction processing", "Optimized for analytical queries", "Better for real-time updates", "Lower storage costs"), 1)
            );
            Collections.shuffle(dwQuestions);
            return dwQuestions.subList(0, Math.min(numberOfQuestions, dwQuestions.size()));
        }
        
        // JavaScript, Java, Python, React questions... (same as before)
        // ... include all the skill-specific questions from previous implementation
        
        return generateGenericProgrammingQuestions(skill, numberOfQuestions);
    }
    
    private Map<String, Object> createQuestion(int id, String question, List<String> options, int correctIndex) {
        return Map.of(
            "id", id,
            "question", question,
            "options", options,
            "correct", correctIndex
        );
    }
    
    private List<Map<String, Object>> generateGenericProgrammingQuestions(String skill, int numberOfQuestions) {
        List<Map<String, Object>> questions = new ArrayList<>();
        Random random = new Random();
        
        String[] genericQuestions = {
            "What is the primary use case for %s?",
            "Which paradigm does %s primarily follow?",
            "What type of technology is %s?",
            "What is %s commonly used for in industry?",
            "Which concept is fundamental to understanding %s?"
        };
        
        String[][] genericOptions = {
            {"Web development", "Mobile development", "Data analysis", "All of the above"},
            {"Object-oriented programming", "Functional programming", "Procedural programming", "Multiple paradigms"},
            {"Programming language", "Framework", "Database", "Development tool"},
            {"Building applications", "Data processing", "System administration", "Various purposes"},
            {"Variables and functions", "Objects and classes", "Data structures", "Depends on the technology"}
        };
        
        for (int i = 0; i < numberOfQuestions; i++) {
            int questionIndex = i % genericQuestions.length;
            String questionText = String.format(genericQuestions[questionIndex], skill);
            questions.add(createQuestion(
                i + 1,
                questionText,
                Arrays.asList(genericOptions[questionIndex]),
                random.nextInt(4)
            ));
        }
        
        return questions;
    }
    
