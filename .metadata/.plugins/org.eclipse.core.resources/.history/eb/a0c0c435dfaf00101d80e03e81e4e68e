package com.cp.workskillai.service;

import com.cp.workskillai.models.UserSkill;
import lombok.RequiredArgsConstructor;
import lombok.extern.slf4j.Slf4j;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.http.*;
import org.springframework.stereotype.Service;
import org.springframework.web.client.RestTemplate;

import java.util.*;

@Slf4j
@Service
@RequiredArgsConstructor
public class HuggingFaceExamService {
    
    private final RestTemplate restTemplate;
    
    @Value("${huggingface.api.key:}")
    private String huggingFaceApiKey;
    
    @Value("${huggingface.api.url:https://api-inference.huggingface.co/models}")
    private String huggingFaceApiUrl;
    
    // Generate exam questions using Hugging Face models
    public Map<String, Object> generateExamQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        try {
            // Use different models based on the skill category
            String model = selectModelForSkill(category);
            
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            headers.set("Authorization", "Bearer " + huggingFaceApiKey);
            
            String prompt = generatePrompt(skill, category, difficulty, numberOfQuestions);
            
            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("inputs", prompt);
            requestBody.put("parameters", Map.of(
                "max_length", 1024,
                "temperature", 0.7,
                "do_sample", true
            ));
            
            HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
            
            ResponseEntity<Map> response = restTemplate.exchange(
                huggingFaceApiUrl + "/" + model,
                HttpMethod.POST,
                request,
                Map.class
            );
            
            if (response.getStatusCode() == HttpStatus.OK) {
                return parseHuggingFaceResponse(response.getBody(), skill, numberOfQuestions);
            }
        } catch (Exception e) {
            log.error("Error generating exam with Hugging Face for skill: {}", skill, e);
        }
        
        // Fallback to rule-based question generation
        return generateRuleBasedQuestions(skill, category, difficulty, numberOfQuestions);
    }
    
    private String selectModelForSkill(String category) {
        Map<String, String> modelMapping = Map.of(
            "programming", "microsoft/DialoGPT-medium",
            "frontend", "microsoft/DialoGPT-medium",
            "backend", "microsoft/DialoGPT-medium", 
            "cloud", "microsoft/DialoGPT-medium",
            "soft skills", "microsoft/DialoGPT-medium",
            "database", "microsoft/DialoGPT-medium"
        );
        return modelMapping.getOrDefault(category.toLowerCase(), "microsoft/DialoGPT-medium");
    }
    
    private String generatePrompt(String skill, String category, String difficulty, int numberOfQuestions) {
        return String.format(
            "Generate %d %s-level multiple choice questions about %s in the %s category. " +
            "Format each question as: Q: [question] A) [option1] B) [option2] C) [option3] D) [option4] Correct: [letter]. " +
            "Make the questions technical and practical.",
            numberOfQuestions, difficulty, skill, category
        );
    }
    
    private Map<String, Object> parseHuggingFaceResponse(Map<String, Object> response, String skill, int numberOfQuestions) {
        try {
            List<Map<String, Object>> questions = new ArrayList<>();
            
            if (response.containsKey("generated_text")) {
                String generatedText = (String) response.get("generated_text");
                // Parse the generated text to extract questions
                questions = parseGeneratedText(generatedText, skill);
            }
            
            // If parsing fails or not enough questions, supplement with rule-based
            if (questions.size() < numberOfQuestions) {
                List<Map<String, Object>> ruleBasedQuestions = generateRuleBasedQuestionsList(skill, numberOfQuestions - questions.size());
                questions.addAll(ruleBasedQuestions);
            }
            
            Map<String, Object> result = new HashMap<>();
            result.put("questions", questions);
            result.put("totalQuestions", questions.size());
            result.put("skill", skill);
            result.put("generatedAt", new Date());
            
            return result;
        } catch (Exception e) {
            log.error("Error parsing Hugging Face response", e);
            return generateRuleBasedQuestions(skill, "general", "intermediate", numberOfQuestions);
        }
    }
    
    private List<Map<String, Object>> parseGeneratedText(String text, String skill) {
        List<Map<String, Object>> questions = new ArrayList<>();
        String[] lines = text.split("\n");
        
        Map<String, Object> currentQuestion = null;
        
        for (String line : lines) {
            if (line.startsWith("Q:")) {
                if (currentQuestion != null) {
                    questions.add(currentQuestion);
                }
                currentQuestion = new HashMap<>();
                currentQuestion.put("question", line.substring(2).trim());
                currentQuestion.put("options", new ArrayList<String>());
            } else if (line.matches("^[A-D]\\) .*")) {
                if (currentQuestion != null) {
                    List<String> options = (List<String>) currentQuestion.get("options");
                    options.add(line.substring(3).trim());
                }
            } else if (line.startsWith("Correct:")) {
                if (currentQuestion != null) {
                    String correctAnswer = line.substring(8).trim();
                    currentQuestion.put("correct", mapAnswerToIndex(correctAnswer));
                }
            }
        }
        
        if (currentQuestion != null) {
            questions.add(currentQuestion);
        }
        
        return questions;
    }
    
    private int mapAnswerToIndex(String answer) {
        return switch (answer.toUpperCase()) {
            case "A" -> 0;
            case "B" -> 1;
            case "C" -> 2;
            case "D" -> 3;
            default -> 0;
        };
    }
    
    private Map<String, Object> generateRuleBasedQuestions(String skill, String category, String difficulty, int numberOfQuestions) {
        Map<String, Object> result = new HashMap<>();
        result.put("questions", generateRuleBasedQuestionsList(skill, numberOfQuestions));
        result.put("totalQuestions", numberOfQuestions);
        result.put("skill", skill);
        result.put("generatedAt", new Date());
        result.put("source", "rule-based");
        return result;
    }
    
    private List<Map<String, Object>> generateRuleBasedQuestionsList(String skill, int numberOfQuestions) {
        List<Map<String, Object>> questions = new ArrayList<>();
        Random random = new Random();
        
        String[][] questionTemplates = {
            {
                "What is the primary purpose of " + skill + "?",
                "Basic syntax and structure",
                "Advanced optimization techniques", 
                "Industry best practices",
                "All of the above",
                "3"
            },
            {
                "Which tool is commonly used with " + skill + "?",
                "Visual Studio Code",
                "Git",
                "Docker", 
                "All of the above",
                "3"
            },
            {
                "What is a key concept in " + skill + "?",
                "Memory management",
                "Error handling",
                "Code organization",
                "All of the above",
                "3"
            },
            {
                "Which methodology is often associated with " + skill + "?",
                "Agile development",
                "Waterfall model", 
                "Scrum framework",
                "All of the above",
                "3"
            }
        };
        
        for (int i = 0; i < Math.min(numberOfQuestions, questionTemplates.length); i++) {
            String[] template = questionTemplates[i % questionTemplates.length];
            Map<String, Object> question = new HashMap<>();
            question.put("id", i + 1);
            question.put("question", template[0]);
            question.put("options", Arrays.asList(template[1], template[2], template[3], template[4]));
            question.put("correct", Integer.parseInt(template[5]));
            questions.add(question);
        }
        
        return questions;
    }
    
    // Alternative: Use Hugging Face for answer evaluation
    public Map<String, Object> evaluateAnswerWithAI(String question, String userAnswer, String context) {
        try {
            HttpHeaders headers = new HttpHeaders();
            headers.setContentType(MediaType.APPLICATION_JSON);
            headers.set("Authorization", "Bearer " + huggingFaceApiKey);
            
            String prompt = String.format(
                "Question: %s\nUser Answer: %s\nContext: %s\nEvaluate if the answer is correct and provide a score from 0-100.",
                question, userAnswer, context
            );
            
            Map<String, Object> requestBody = new HashMap<>();
            requestBody.put("inputs", prompt);
            
            HttpEntity<Map<String, Object>> request = new HttpEntity<>(requestBody, headers);
            
            ResponseEntity<Map> response = restTemplate.exchange(
                huggingFaceApiUrl + "/microsoft/DialoGPT-medium",
                HttpMethod.POST,
                request,
                Map.class
            );
            
            if (response.getStatusCode() == HttpStatus.OK) {
                return parseEvaluationResponse(response.getBody());
            }
        } catch (Exception e) {
            log.error("Error evaluating answer with Hugging Face", e);
        }
        
        return Map.of("score", 50, "feedback", "Evaluation unavailable");
    }
    
    private Map<String, Object> parseEvaluationResponse(Map<String, Object> response) {
        // Parse the AI response to extract score and feedback
        // This is a simplified implementation
        return Map.of(
            "score", 75,
            "feedback", "The answer shows good understanding but could be more detailed.",
            "confidence", 0.85
        );
    }
}