package com.cp.workskillai.controller;

import com.cp.workskillai.service.HuggingFaceExamService;
import lombok.RequiredArgsConstructor;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.util.Map;

@RestController
@RequestMapping("/api/skills")
@RequiredArgsConstructor
public class ExamController {
    
    private final HuggingFaceExamService huggingFaceExamService;
    
    @PostMapping("/generate-exam")
    public ResponseEntity<Map<String, Object>> generateExam(
            @RequestBody Map<String, Object> request) {
        
        String skill = (String) request.get("skill");
        String category = (String) request.get("category");
        String difficulty = (String) request.get("difficulty");
        int numberOfQuestions = (int) request.get("numberOfQuestions");
        
        Map<String, Object> exam = huggingFaceExamService.generateExamQuestions(
            skill, category, difficulty, numberOfQuestions
        );
        
        return ResponseEntity.ok(exam);
    }
    
    @PostMapping("/evaluate-answer")
    public ResponseEntity<Map<String, Object>> evaluateAnswer(
            @RequestBody Map<String, Object> request) {
        
        String question = (String) request.get("question");
        String userAnswer = (String) request.get("userAnswer");
        String context = (String) request.get("context");
        
        Map<String, Object> evaluation = huggingFaceExamService.evaluateAnswerWithAI(
            question, userAnswer, context
        );
        
        return ResponseEntity.ok(evaluation);
    }
}